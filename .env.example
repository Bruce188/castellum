DATABASE_URL=jdbc:postgresql://localhost:5432/castellum
DATABASE_USERNAME=castellum
DATABASE_PASSWORD=change-me-locally
SERVER_PORT=8080
# NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# NVD_API_KEY=
# EPSS_FEED_URL=https://epss.cyentia.com/epss_scores-current.csv.gz
# KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# RISK_REFRESH_CRON=0 0 6 * * *
# DISCOVERY_DURATION_SECONDS=30
# DISCOVERY_ARP_PATH=/proc/net/arp
# DISCOVERY_MDNS_SERVICE_TYPES=_workstation._tcp.local.,_http._tcp.local.
# DISCOVERY_PCAP_ENABLED=false
# DISCOVERY_LLDP_ENABLED=false
# DISCOVERY_CDP_ENABLED=false
# DISCOVERY_BPF_FILTER=arp or (udp and port 5353) or (udp and port 67) or (udp and port 68)
# GRAPH_SUBNET_CAP=64
# GRAPH_VULNS_PER_PAIR_CAP=5
# OT/ICS read-only fingerprinter timeouts (milliseconds)
# OT_PROBE_CONNECT_TIMEOUT_MS=3000
# OT_PROBE_READ_TIMEOUT_MS=5000
# OT_PROBE_TOTAL_TIMEOUT_MS=10000
# OT_PROBE_MAX_CONCURRENT=8
# STIX/TAXII push client
TAXII_BASE_URL=
TAXII_COLLECTION_ID=
TAXII_USERNAME=
TAXII_PASSWORD=
# MISP push client
MISP_BASE_URL=
MISP_API_KEY=
MISP_DISTRIBUTION=0
MISP_THREAT_LEVEL_ID=2

# Security
# REQUIRED — generate with: openssl rand -base64 48
# JWT — must be ≥32 bytes
# CASTELLUM_SECURITY_JWT_SECRET=

# Bootstrap admin (BCrypt strength-12 hash); generate with:
#   htpasswd -bnBC 12 "" "your-password" | tr -d ':\n'
CASTELLUM_ADMIN_USERNAME=
CASTELLUM_ADMIN_PASSWORD_HASH=

# Bootstrap viewer (BCrypt strength-12 hash); generate with:
#   htpasswd -bnBC 12 "" "your-password" | tr -d ':\n'
CASTELLUM_VIEWER_USERNAME=
CASTELLUM_VIEWER_PASSWORD_HASH=

# Async scan executor pool (defaults are conservative; raise for high-volume environments).
# CASTELLUM_SCAN_EXECUTOR_CORE_POOL_SIZE=2
# CASTELLUM_SCAN_EXECUTOR_MAX_POOL_SIZE=4
# CASTELLUM_SCAN_EXECUTOR_QUEUE_CAPACITY=10
# CASTELLUM_SCAN_NMAP_PORT_SCAN_HOST_TIMEOUT=180s
# CASTELLUM_SCAN_NMAP_PING_HOST_TIMEOUT=30s

# Login rate-limit (sliding window, per-IP); single-instance only.
# CASTELLUM_SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# CASTELLUM_SECURITY_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10

# CORS allowed origins (comma-separated; bare * forbidden, http://
# only allowed for localhost). Dev default: http://localhost:5173.
# CORS_ALLOWED_ORIGINS=https://operator.example.com
